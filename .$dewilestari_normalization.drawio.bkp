<mxfile host="app.diagrams.net" modified="2026-08-09T19:42:00.000Z" agent="5.0" version="21.0.0" type="device">
  <diagram id="NormalisasiDewiLestari" name="Normalisasi Database">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Tahap Normalisasi Database Sistem Dewi Lestari 2&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="800" height="35" as="geometry" />
        </mxCell>

        <!-- STAGE 1: UNF -->
        <mxCell id="box_unf" value="&lt;b&gt;1. UNNORMALIZED FORM (UNF)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Seluruh Atribut Digabung Tanpa Struktur)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="txt_unf" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;{ id_order, order_number, order_date, total_amount, shipping_cost, delivery_option, courier_type, payment_method, payment_status, snap_token, tracking_ticket, shipping_status, delivery_proof, user_id, user_name, user_email, user_phone, user_address, city, province, postal_code, ( supplier_stock_id, product_name, variant_name, size, selling_price, hpp, stock, expiry_date, quantity, subtotal )*, supplier_id, supplier_name, supplier_phone, supplier_email, supplier_address, ( supplier_order_id, po_date, po_qty, po_status )*, ( return_id, return_date, return_qty, reason )*, ( log_id, log_type, qty_change, description )*, ( rating_id, stars, comment )* }&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;spacingLeft=5;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="125" width="1440" height="90" as="geometry" />
        </mxCell>

        <!-- STAGE 2: 1NF -->
        <mxCell id="box_1nf" value="&lt;b&gt;2. FIRST NORMAL FORM (1NF)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Menghilangkan Group Berulang &amp;amp; Setiap Atribut Bernilai Atomik)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="1480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="txt_1nf" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;TABEL DENGAN PRIMARY KEY TERDEFINISI (TANPA ATRIBUT REPEATING):&lt;/b&gt;&lt;br/&gt;&lt;u&gt;id_order&lt;/u&gt;, order_number, order_date, total_amount, shipping_cost, delivery_option, courier_type, payment_method, payment_status, snap_token, tracking_ticket, shipping_status, delivery_proof, &lt;u&gt;user_id&lt;/u&gt;, user_name, user_email, user_password, user_phone, user_address, city, province, postal_code, &lt;u&gt;supplier_stock_id&lt;/u&gt;, product_name, variant_name, size, selling_price, hpp, stock, expiry_date, item_quantity, item_subtotal, &lt;u&gt;supplier_id&lt;/u&gt;, supplier_name, supplier_phone, supplier_email, supplier_address, &lt;u&gt;supplier_order_id&lt;/u&gt;, po_date, po_qty, po_status, &lt;u&gt;return_id&lt;/u&gt;, return_date, return_qty, reason, &lt;u&gt;log_id&lt;/u&gt;, log_type, qty_change, log_description, &lt;u&gt;rating_id&lt;/u&gt;, stars, comment&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;spacingLeft=5;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="305" width="1440" height="90" as="geometry" />
        </mxCell>

        <!-- STAGE 3: 2NF -->
        <mxCell id="box_2nf" value="&lt;b&gt;3. SECOND NORMAL FORM (2NF)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Menghilangkan Ketergantungan Parsial - Memecah Menjadi Entitas Spesifik)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="1480" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tabel_2nf_desc" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;PEMBAGIAN ENTITAS SESUAI PRIMARY KEY:&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;USERS&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, name, email, password, plain_password, phone_number, role, address, city, province, postal_code)&lt;br/&gt;&amp;bull; &lt;b&gt;SUPPLIERS&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, name, phone_number, email, address)&lt;br/&gt;&amp;bull; &lt;b&gt;SUPPLIER_STOCKS&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, supplier_id, product_name, variant_name, size, selling_price, hpp, stock, expiry_date, status)&lt;br/&gt;&amp;bull; &lt;b&gt;ORDERS&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, user_id, order_number, total_amount, shipping_cost, delivery_option, courier_type, payment_method, payment_status, snap_token, tracking_ticket, shipping_status, delivery_proof)&lt;br/&gt;&amp;bull; &lt;b&gt;ORDER_ITEMS&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, order_id, supplier_stock_id, quantity, price, subtotal)&lt;br/&gt;&amp;bull; &lt;b&gt;SUPPLIER_ORDERS&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, supplier_id, supplier_stock_id, order_date, quantity_ordered, status)&lt;br/&gt;&amp;bull; &lt;b&gt;SUPPLIER_RETURNS&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, supplier_id, supplier_stock_id, return_date, quantity_returned, reason)&lt;br/&gt;&amp;bull; &lt;b&gt;STOCK_LOGS&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, supplier_stock_id, user_id, type, quantity_change, description)&lt;br/&gt;&amp;bull; &lt;b&gt;RATINGS&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, order_id, user_id, supplier_stock_id, stars, comment)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;spacingLeft=5;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="485" width="1440" height="200" as="geometry" />
        </mxCell>

        <!-- STAGE 4: 3NF -->
        <mxCell id="box_3nf" value="&lt;b&gt;4. THIRD NORMAL FORM (3NF) - BENTUK FINAL TER-NORMALISASI sempurna&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Menghilangkan Ketergantungan Transitif - Memisahkan Alamat Pelanggan dari Profil User)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="1480" height="340" as="geometry" />
        </mxCell>

        <mxCell id="tabel_3nf_desc" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;STRUKTUR RELASIONAL FINAL 3NF (11 TABEL TERISOLASI TANPA REDUNDANSI):&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;1. &lt;b&gt;users&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, name, email, password, plain_password, phone_number, role)&lt;br/&gt;2. &lt;b&gt;user_addresses&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, user_id*, recipient_name, phone_number, address, city, province, postal_code, is_primary)&lt;br/&gt;3. &lt;b&gt;suppliers&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, name, phone_number, email, address)&lt;br/&gt;4. &lt;b&gt;supplier_stocks&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, supplier_id*, product_name, variant_name, size, selling_price, hpp, stock, expiry_date, status)&lt;br/&gt;5. &lt;b&gt;orders&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, user_id*, address_id*, order_number, total_amount, shipping_cost, delivery_option, courier_type, payment_method, payment_status, snap_token, tracking_ticket, shipping_status, delivery_proof)&lt;br/&gt;6. &lt;b&gt;order_items&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, order_id*, supplier_stock_id*, quantity, price, subtotal)&lt;br/&gt;7. &lt;b&gt;supplier_orders&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, supplier_id*, supplier_stock_id*, order_date, quantity_ordered, status)&lt;br/&gt;8. &lt;b&gt;supplier_returns&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, supplier_id*, supplier_stock_id*, return_date, quantity_returned, reason)&lt;br/&gt;9. &lt;b&gt;stock_logs&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, supplier_stock_id*, user_id*, type, quantity_change, description)&lt;br/&gt;10. &lt;b&gt;ratings&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, order_id*, user_id*, supplier_stock_id*, stars, comment)&lt;br/&gt;11. &lt;b&gt;messages&lt;/b&gt; (&lt;u&gt;id&lt;/u&gt;, sender_id*, receiver_id*, message_text, read_at)&lt;/font&gt;" style="text;html=1;strokeColor=none;fill=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;spacingLeft=5;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="765" width="1440" height="285" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
