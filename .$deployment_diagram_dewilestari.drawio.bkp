  <diagram id="DewiLestariDeploymentDiagram" name="Deployment Diagram Dewi Lestari (B&amp;W)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="DEPLOYMENT DIAGRAM SISTEM E-COMMERCE TOKO DEWI LESTARI 2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Diagram Arsitektur Fisik &amp; Penggelaran Infrastruktur Hardware/Software (Hitam-Putih Formal)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#333333;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="55" width="1100" height="25" as="geometry" />
        </mxCell>

        <!-- NODE 1: CLIENT TIER (PERANGKAT PENGGUNA) -->
        <mxCell id="node_client" value="«Device»&#xa;1. Client Tier (Perangkat Pengguna)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="380" height="680" as="geometry" />
        </mxCell>

        <!-- Components inside Client Tier -->
        <mxCell id="comp_cust_device" value="«Execution Environment»&#xa;&lt;b&gt;Perangkat Pelanggan (Customer Device)&lt;/b&gt;&lt;hr/&gt;• Web Browser (Chrome, Safari, Edge)&lt;br/&gt;• Interface Katalog &amp; Checkout&lt;br/&gt;• Form Upload Bukti Pembayaran&lt;br/&gt;• Live Chat Interaktif&lt;br/&gt;• Peta Lacak Pengiriman Leaflet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="170" width="330" height="170" as="geometry" />
        </mxCell>

        <mxCell id="comp_admin_device" value="«Execution Environment»&#xa;&lt;b&gt;Perangkat Admin / Kasir Toko&lt;/b&gt;&lt;hr/&gt;• Web Browser Desktop (Chrome, Firefox)&lt;br/&gt;• Panel Kelola Pesanan &amp; Verifikasi Struk&lt;br/&gt;• Panel Laporan Penjualan (Harian/Mingguan/Bulanan)&lt;br/&gt;• Kelola Stok FIFO Varian &amp; Suplier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="370" width="330" height="170" as="geometry" />
        </mxCell>

        <mxCell id="comp_courier_device" value="«Execution Environment»&#xa;&lt;b&gt;Perangkat Kurir Toko (Courier Mobile Device)&lt;/b&gt;&lt;hr/&gt;• Smartphone Browser / Mobile Web&lt;br/&gt;• Portal Tugas Pengiriman Kurir&lt;br/&gt;• Update Status (Dikirim / Hampir Sampai)&lt;br/&gt;• Upload Foto Bukti Penerimaan Barang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="570" width="330" height="170" as="geometry" />
        </mxCell>


        <!-- NODE 2: WEB & APPLICATION SERVER TIER -->
        <mxCell id="node_appserver" value="«Server Node»&#xa;2. Web &amp; Application Server (Apache XAMPP / Hosting)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="110" width="460" height="680" as="geometry" />
        </mxCell>

        <!-- Components inside Web/App Server -->
        <mxCell id="comp_webserver" value="«Web Server»&#xa;&lt;b&gt;Apache HTTP Server 2.4 (Port 80 / 443)&lt;/b&gt;&lt;hr/&gt;• Protocol: HTTP / HTTPS&lt;br/&gt;• mod_rewrite (URL Routing)&lt;br/&gt;• SSL/TLS Encryption" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="170" width="400" height="110" as="geometry" />
        </mxCell>

        <mxCell id="comp_laravel" value="«Application Framework»&#xa;&lt;b&gt;Laravel 10.x Framework (PHP 8.1+)&lt;/b&gt;&lt;hr/&gt;• MVC Routing &amp; Middleware Authentication&lt;br/&gt;• OrderController (Logika Transaksi &amp; Verifikasi)&lt;br/&gt;• CustomerController &amp; SupplierController&lt;br/&gt;• Algoritma Pemotongan Stok FIFO (decrementStock)&lt;br/&gt;• Blade Template Rendering Engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="310" width="400" height="180" as="geometry" />
        </mxCell>

        <mxCell id="comp_filesystem" value="«File Storage Component»&#xa;&lt;b&gt;Local File System Storage&lt;/b&gt;&lt;hr/&gt;• /uploads/transfer_proofs/ (Struk Bukti Transfer)&lt;br/&gt;• /uploads/delivery_proofs/ (Foto Bukti Terima Kurir)&lt;br/&gt;• /uploads/return_proofs/ (Foto Bukti Retur)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="520" width="400" height="140" as="geometry" />
        </mxCell>

        <mxCell id="comp_dompdf" value="«Library Component»&#xa;&lt;b&gt;Dompdf PDF Generator&lt;/b&gt;&lt;hr/&gt;• Cetak Laporan Toko &amp; Suplier (PDF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="680" width="400" height="80" as="geometry" />
        </mxCell>


        <!-- NODE 3: DATABASE SERVER TIER -->
        <mxCell id="node_db" value="«Database Server Node»&#xa;3. Database Server (MySQL / MariaDB)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="110" width="380" height="340" as="geometry" />
        </mxCell>

        <mxCell id="comp_mysqldb" value="«Database Engine»&#xa;&lt;b&gt;MySQL 8.0 / MariaDB 10.4 (Port 3306)&lt;/b&gt;&lt;hr/&gt;• Database Name: dewilestariweb&lt;br/&gt;• 11 Tabel Relasional (InnoDB Engine)&lt;br/&gt;• FK Constraints &amp; Indexing&lt;br/&gt;• Data Transaksi, Stok FIFO &amp; Live Chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
