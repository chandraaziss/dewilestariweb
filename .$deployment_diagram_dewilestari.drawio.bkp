        <mxCell id="comp_google" value="«External API»&#xa;&lt;b&gt;Google OAuth 2.0 Authentication&lt;/b&gt;&lt;hr/&gt;• Login Pelanggan via Google Account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1045" y="625" width="330" height="65" as="geometry" />
