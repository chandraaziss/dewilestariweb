        <mxCell id="comp_osm" value="«External API»&#xa;&lt;b&gt;OpenStreetMap &amp; Leaflet Geocoding API&lt;/b&gt;&lt;hr/&gt;• Nominatim API &amp; Map Tiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
