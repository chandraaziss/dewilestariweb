        <mxCell id="link_client_app" value="HTTP / HTTPS (Port 80 / 443)&#xa;JSON / HTML Response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;fontStyle=1;" edge="1" parent="1" source="node_client" target="node_appserver">
