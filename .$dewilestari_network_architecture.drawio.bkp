  <diagram id="NetworkArchitectureBW" name="4.4 Arsitektur Jaringan">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Gambar 4.35 Diagram Perancangan Arsitektur Jaringan Sistem Toko Dewi Lestari 2&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="1100" height="40" as="geometry" />
        </mxCell>

        <!-- TIER 1: CLIENT ACCESS LAYER -->
        <mxCell id="box_client_tier" value="&lt;b&gt;TIER 1: CLIENT ACCESS LAYER (PENGGUNA)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontColor=#000000;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="300" height="500" as="geometry" />
        </mxCell>

        <mxCell id="c_cust" value="&lt;b&gt;Perangkat Pelanggan&lt;/b&gt;&lt;br&gt;(Smartphone / PC / Laptop)&lt;br&gt;• Web Browser (Chrome/Safari)&lt;br&gt;• IP Public Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=center;" vertex="1" parent="box_client_tier">
          <mxGeometry x="30" y="60" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c_admin" value="&lt;b&gt;Perangkat Admin &amp; Pengelola&lt;/b&gt;&lt;br&gt;(PC Workstation / Laptop)&lt;br&gt;• Web Browser (Control Panel)&lt;br&gt;• IP Office Admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=center;" vertex="1" parent="box_client_tier">
          <mxGeometry x="30" y="210" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="isp_cloud" value="&lt;b&gt;Internet Service Provider (ISP)&lt;/b&gt;&lt;br&gt;Jaringan Internet (4G/5G/Wi-Fi)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=center;" vertex="1" parent="box_client_tier">
          <mxGeometry x="30" y="350" width="240" height="100" as="geometry" />
        </mxCell>


        <!-- TIER 2: CLOUD & SERVER HOSTING LAYER -->
        <mxCell id="box_server_tier" value="&lt;b&gt;TIER 2: SHARED HOSTING SERVER ENVIRONMENT (dewilestari.com)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontColor=#000000;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="700" height="500" as="geometry" />
        </mxCell>

        <!-- SECURITY & FIREWALL -->
        <mxCell id="sec_ssl" value="&lt;b&gt;Cloudflare / SSL TLS Certificate&lt;/b&gt;&lt;br&gt;Enkripsi HTTPS (Port 443) &amp; DDoS Firewall Protection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=center;" vertex="1" parent="box_server_tier">
          <mxGeometry x="40" y="50" width="620" height="50" as="geometry" />
        </mxCell>

        <!-- WEB SERVER CONTAINER -->
        <mxCell id="box_webserver" value="&lt;b&gt;Web &amp; Application Server (Apache / Nginx)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;fontColor=#000000;startSize=25;" vertex="1" parent="box_server_tier">
          <mxGeometry x="40" y="130" width="290" height="340" as="geometry" />
        </mxCell>

        <mxCell id="app_laravel" value="&lt;b&gt;Laravel Framework 11 (PHP 8.2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Routing &amp; Middleware Auth&lt;br&gt;• Business Logic Controllers&lt;br&gt;• Midtrans Snap Integration&lt;br&gt;• RajaOngkir HTTP Client&lt;br&gt;• WhatsApp API Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_webserver">
          <mxGeometry x="20" y="40" width="250" height="270" as="geometry" />
        </mxCell>

        <!-- DATABASE SERVER CONTAINER -->
        <mxCell id="box_dbserver" value="&lt;b&gt;Database Server (MySQL Engine)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;fontColor=#000000;startSize=25;" vertex="1" parent="box_server_tier">
          <mxGeometry x="370" y="130" width="290" height="340" as="geometry" />
        </mxCell>

        <mxCell id="db_mysql" value="&lt;b&gt;MySQL / MariaDB Database&lt;/b&gt;&lt;br&gt;&lt;i&gt;Bound to Localhost (127.0.0.1:3306)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Entity Tables (11 Tables)&lt;br&gt;• Primary &amp; Foreign Keys&lt;br&gt;• Transaction Indexes&lt;br&gt;• Daily Automated Backup" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_dbserver">
          <mxGeometry x="20" y="40" width="250" height="270" as="geometry" />
        </mxCell>


        <!-- TIER 3: THIRD-PARTY EXTERNAL INTEGRATION LAYER -->
        <mxCell id="box_api_tier" value="&lt;b&gt;TIER 3: THIRD-PARTY EXTERNAL SERVICES INTEGRATION&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontColor=#000000;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="1220" y="80" width="320" height="500" as="geometry" />
        </mxCell>

        <mxCell id="api_midtrans" value="&lt;b&gt;Midtrans Payment Gateway Server&lt;/b&gt;&lt;br&gt;• Snap Payment API&lt;br&gt;• Virtual Account / QRIS&lt;br&gt;• Webhook Notifikasi Lunas&lt;br&gt;&lt;i&gt;(HTTPS Port 443)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=center;" vertex="1" parent="box_api_tier">
          <mxGeometry x="30" y="50" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="api_rajaongkir" value="&lt;b&gt;RajaOngkir Logistics Server&lt;/b&gt;&lt;br&gt;• Cek Tarif Ongkir Realtime&lt;br&gt;• JNE / POS / TIKI API&lt;br&gt;• Query Kota &amp; Provinsi&lt;br&gt;&lt;i&gt;(HTTPS Port 443)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=center;" vertex="1" parent="box_api_tier">
          <mxGeometry x="30" y="190" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="api_wa" value="&lt;b&gt;WhatsApp Gateway Server&lt;/b&gt;&lt;br&gt;• Kirim Order PO Supplier&lt;br&gt;• Auto Message Order Code&lt;br&gt;• Direct Order Notification&lt;br&gt;&lt;i&gt;(HTTPS Port 443)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=center;" vertex="1" parent="box_api_tier">
          <mxGeometry x="30" y="330" width="260" height="100" as="geometry" />
        </mxCell>


        <!-- NETWORK CONNECTION LINES WITH PROTOCOLS & PORTS -->
        <mxCell id="conn_c1_isp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="c_cust" target="isp_cloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_c2_isp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="c_admin" target="isp_cloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="conn_isp_sec" value="HTTPS (Port 443)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontStyle=1;fontSize=11;" edge="1" parent="1" source="isp_cloud" target="sec_ssl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="conn_sec_web" value="HTTP (Port 80)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="sec_ssl" target="box_webserver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="conn_web_db" value="SQL (Port 3306)&lt;br&gt;Localhost" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=classic;startArrow=classic;strokeColor=#000000;strokeWidth=2;fontStyle=1;fontSize=10;" edge="1" parent="1" source="box_webserver" target="box_dbserver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API CONNECTIONS -->
        <mxCell id="conn_web_midtrans" value="HTTPS API (Port 443)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;endArrow=classic;startArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="sec_ssl" target="api_midtrans">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_web_rajaongkir" value="HTTPS API (Port 443)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=classic;startArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="sec_ssl" target="api_rajaongkir">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_web_wa" value="HTTPS API (Port 443)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="sec_ssl" target="api_wa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

